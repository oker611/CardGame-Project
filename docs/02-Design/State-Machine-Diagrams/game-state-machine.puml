@startuml
' 锄大地卡牌游戏 — 游戏主状态机 (State Machine Diagram)

skinparam state {
  BackgroundColor LightBlue
  BorderColor DarkBlue
  FontSize 12
}

[*] --> 游戏未开始

state 游戏未开始 {
  [*] --> 等待配置
  等待配置 --> 配置就绪 : 选择规则 + 难度
}

配置就绪 --> 开局发牌 : startNewGame()

state 开局发牌 {
  [*] --> 生成52张牌
  生成52张牌 --> 洗牌
  洗牌 --> 分配13张x4人
  分配13张x4人 --> 识别首发玩家
  识别首发玩家 --> [*]
}

开局发牌 --> 玩家回合 : 发布 TurnChangedEvent

state 玩家回合 {
  [*] --> 等待操作

  等待操作 --> 出牌 : Human/AI 选择出牌
  等待操作 --> 过牌 : Human/AI 选择过牌

  出牌 --> 校验合法性
  校验合法性 --> 出牌成功 : 合法
  校验合法性 --> 等待操作 : 不合法 (重新选择)

  出牌成功 --> 更新GameState
  更新GameState --> 检查游戏结束

  过牌 --> 标记Pass
  标记Pass --> 检查连续Pass

  state 检查连续Pass {
    连续Pass<3 --> 切换回合
    连续Pass>=3 --> 清空桌面
    清空桌面 --> 切换回合
  }

  切换回合 --> [*] : 发布 TurnChangedEvent

  检查游戏结束 --> 游戏结束 : 有玩家手牌=0
  检查游戏结束 --> 切换回合 : 继续游戏
}

玩家回合 --> 玩家回合 : 循环直到游戏结束

state 游戏结束 {
  [*] --> 排名计算
  排名计算 --> 展示结果
  展示结果 --> [*]
}

游戏结束 --> [*]

@enduml
